---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const featured = posts[0];
---

<BaseLayout>
  <section class="hero hero-home">
    <div class="container hero-split">
      <div class="hero-copy">
        <div class="eyebrow">Guías prácticas para familias digitales</div>
        <h1>Tecnología que les acerca al mundo.<br />Información que les mantiene <span>seguros.</span></h1>
        <p class="lead">Conecta y Protege es una guía práctica y cercana para madres, padres y educadores que quieren aprovechar lo mejor de la tecnología y reducir sus riesgos en la vida de sus hijos e hijas.</p>
        <div class="actions">
          <a class="button primary" href="/guias">Ver guías →</a>
          <a class="button secondary" href="/sobre-el-proyecto">Sobre el proyecto</a>
        </div>
      </div>

      <div class="hero-photo">
        <img src="/images/familia-mundo-digital-seguro.webp" width="1536" height="1024" loading="eager" fetchpriority="high" alt="Familia compartiendo un momento frente a un ordenador con el mensaje Un mundo digital más seguro" />
      </div>
    </div>
  </section>

  <section class="principles-strip" id="recursos">
    <div class="container principles-grid">
      <article class="principle"><div class="principle-icon">▤</div><div><h3>Guías paso a paso</h3><p>Explicaciones claras y sin tecnicismos, con capturas y ejemplos.</p></div></article>
      <article class="principle"><div class="principle-icon">◈</div><div><h3>Basado en evidencias</h3><p>Recomendaciones prácticas apoyadas en buenas prácticas y fuentes fiables.</p></div></article>
      <article class="principle"><div class="principle-icon">●</div><div><h3>Enfocado en la vida real</h3><p>Soluciones pensadas para problemas cotidianos de las familias.</p></div></article>
      <article class="principle"><div class="principle-icon">♥</div><div><h3>Una mirada positiva</h3><p>Menos miedo, más herramientas para un uso equilibrado.</p></div></article>
    </div>
  </section>

  <section class="section featured-guides">
    <div class="container">
      <div class="section-heading-row"><div><div class="eyebrow">Guías destacadas</div><h2>Empieza por aquí</h2><p>Recursos prácticos para los retos más comunes.</p></div><a class="text-link" href="/guias">Ver todas las guías →</a></div>
      <div class="guide-grid">
        {featured && (<a class="guide-card" href={`/guias/${featured.id}/`}><div class="guide-icon blue">▰</div><h3>{featured.data.title}</h3><p>{featured.data.description}</p><div class="guide-meta"><span>Nivel: Fácil</span><span>{featured.data.readingTime ?? '10 min'}</span></div></a>)}
        <article class="guide-card muted-card"><div class="guide-icon green">▯</div><h3>Primer móvil: decisiones clave</h3><p>Qué valorar antes de dar el primer smartphone y cómo prepararlo.</p><div class="guide-meta"><span>Próximamente</span><span>15 min</span></div></article>
        <article class="guide-card muted-card"><div class="guide-icon purple">✦</div><h3>Videojuegos en familia</h3><p>Cómo elegir, configurar y acompañar los videojuegos de forma segura.</p><div class="guide-meta"><span>Próximamente</span><span>25 min</span></div></article>
        <article class="guide-card muted-card"><div class="guide-icon amber">●●</div><h3>Redes sociales: guía para padres</h3><p>Qué conviene saber, qué puedes hacer y cómo acompañarles.</p><div class="guide-meta"><span>Próximamente</span><span>20 min</span></div></article>
      </div>
      <div class="subscribe-band" id="suscribete"><div class="subscribe-icon">✉</div><div><h3>Recibe nuevas guías en tu correo</h3><p>Sin spam. Solo contenido útil para familias.</p></div><a class="button primary" href="mailto:hola@conectayprotege.com?subject=Quiero%20suscribirme%20a%20Conecta%20y%20Protege">Suscribirme</a></div>
      <p class="closing-note">Pequeños pasos.<br /><strong>Grandes diferencias.</strong></p>
    </div>
  </section>
</BaseLayout>
