---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const seriesPosts = posts.filter((post) => post.data.type === 'article' && post.data.series === 'historia').sort((a,b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const technicalGuides = posts.filter((post) => post.data.type === 'technical').sort((a,b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout>
  <section class="home-hero-new">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <div class="eyebrow">Acompañar hoy, un mañana más seguro</div>
        <h1>Conecta hoy<br />para que mañana<br /><span>lleguen más lejos</span></h1>
        <p class="lead">Guías, consejos y experiencias reales para acompañar a nuestros hijos hacia un uso de la tecnología más seguro, saludable y equilibrado.</p>
        <div class="actions"><a class="button primary" href="/articulos">Explora los artículos →</a><a class="button secondary" href="/sobre-el-proyecto">Sobre el proyecto</a></div>
      </div>
      <div class="home-hero-image">
        <img src="/images/home-acompanamiento.webp" width="1100" height="990" loading="eager" fetchpriority="high" alt="Un padre acompañando a su hijo por un camino al atardecer" />
        <div class="home-hero-note">Pequeños pasos,<br /><strong>grandes futuros</strong></div>
      </div>
    </div>
  </section>

  <section class="principles-strip" id="recursos"><div class="container principles-grid">
    <article class="principle"><div class="principle-icon">⌑</div><div><h3>Aprende</h3><p>Guías claras y prácticas.</p></div></article>
    <article class="principle"><div class="principle-icon">◎</div><div><h3>Acompaña</h3><p>Herramientas para el día a día.</p></div></article>
    <article class="principle"><div class="principle-icon">◇</div><div><h3>Protege</h3><p>Un entorno digital más seguro.</p></div></article>
    <article class="principle"><div class="principle-icon">♧</div><div><h3>Hazles crecer</h3><p>Con confianza y sin miedos.</p></div></article>
  </div></section>

  <section class="section featured-guides"><div class="container">
    <div class="section-heading-row"><div><div class="eyebrow">Artículos recientes</div><h2>Ideas y recursos para tu día a día</h2><p>Experiencias, decisiones y configuraciones explicadas de forma cercana y práctica.</p></div><a class="text-link" href="/articulos">Ver todos los artículos →</a></div>
    <div class="guide-grid">{seriesPosts.map((post) => (<a class="guide-card" href={`/guias/${post.id}/`}><div class={`guide-icon ${(post.data.order ?? 0) % 2 ? 'blue' : 'green'}`}>{post.data.order}</div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="guide-meta"><span>Artículo {post.data.order}</span><span>{post.data.readingTime ?? '10 min'}</span></div></a>))}</div>

    <div style="margin-top:64px;" class="section-heading-row"><div><div class="eyebrow">¿Quieres profundizar?</div><h2>Guías técnicas</h2><p>Configuraciones reales para quienes quieren ir un paso más allá. Son opcionales: puedes seguir la historia principal sin entrar en ellas.</p></div><a class="text-link" href="/guias-tecnicas">Ver guías técnicas →</a></div>
    <div class="article-list">{technicalGuides.map((post) => (<a class="article-card" href={`/guias/${post.id}/`}><div class="article-meta">GUÍA TÉCNICA<br />Nivel {post.data.level ?? 'intermedio'}</div><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><div class="article-arrow">Ver configuración →</div></a>))}</div>

    <div class="notice" style="margin-top:48px;"><strong>Los controles no eliminan el riesgo. Nos ayudan a reducirlo.</strong><p style="margin-bottom:0;">La protección más eficaz combina herramientas técnicas con supervisión, educación y diálogo.</p></div>
    <div class="subscribe-band" id="suscribete"><div class="subscribe-icon">✉</div><div><h3>Nuevas guías para proteger mejor, no para vigilar más</h3><p>Información práctica sobre riesgos, controles y acompañamiento familiar.</p></div><button class="button primary" id="open-subscribe" type="button">Suscribirme</button></div>

    <dialog id="subscribe-modal" class="subscribe-modal" aria-labelledby="subscribe-title">
      <div class="subscribe-modal-inner">
        <button class="subscribe-close" type="button" aria-label="Cerrar">×</button>
        <div class="subscribe-modal-copy">
          <div class="eyebrow">Conecta y Protege</div>
          <h2 id="subscribe-title">Sigue aprendiendo a protegerles</h2>
          <p>Nuevos artículos y guías prácticas sobre seguridad digital, controles parentales y acompañamiento familiar.</p>
        </div>
        <div class="subscribe-kit" id="kit-form-container"></div>
      </div>
    </dialog>

    <script is:inline>
      (() => {
        const modal = document.getElementById('subscribe-modal');
        const open = document.getElementById('open-subscribe');
        const headerOpen = document.querySelector('[data-open-subscribe]');
        const close = modal?.querySelector('.subscribe-close');
        let kitLoaded = false;

        const loadKitForm = () => {
          if (kitLoaded) return;
          const container = document.getElementById('kit-form-container');
          if (!container) return;
          const script = document.createElement('script');
          script.async = true;
          script.dataset.uid = '2631c9d7fb';
          script.src = 'https://conecta-y-protege.kit.com/2631c9d7fb/index.js';
          container.appendChild(script);
          kitLoaded = true;
        };

        const showSubscribe = (event) => {
          event?.preventDefault();
          modal?.showModal();
          loadKitForm();
        };
        open?.addEventListener('click', showSubscribe);
        headerOpen?.addEventListener('click', showSubscribe);
        close?.addEventListener('click', () => modal?.close());
        modal?.addEventListener('click', (event) => {
          if (event.target === modal) modal.close();
        });
      })();
    </script>

    <style is:inline>
      .subscribe-modal{border:0;padding:0;border-radius:22px;max-width:760px;width:calc(100% - 32px);box-shadow:0 24px 80px rgba(0,0,0,.28);background:var(--surface,#fff)}
      .subscribe-modal::backdrop{background:rgba(15,23,42,.62);backdrop-filter:blur(3px)}
      .subscribe-modal-inner{position:relative;padding:34px}
      .subscribe-close{position:absolute;right:16px;top:12px;border:0;background:transparent;font-size:32px;line-height:1;cursor:pointer;color:inherit;opacity:.65}
      .subscribe-close:hover{opacity:1}
      .subscribe-modal-copy{max-width:600px;margin:0 auto 22px;text-align:center}
      .subscribe-modal-copy h2{margin:.35rem 0 .6rem}
      .subscribe-modal-copy p{margin:0}
      .subscribe-kit{max-width:680px;margin:0 auto}
      #open-subscribe{font:inherit;cursor:pointer}
      @media(max-width:640px){.subscribe-modal-inner{padding:28px 18px 20px}.subscribe-modal-copy{text-align:left;padding-right:24px}}
    </style>
    <p class="closing-note">La tecnología puede ayudar a proteger.<br /><strong>La supervisión y el acompañamiento siguen siendo esenciales.</strong></p>
  </div></section>
</BaseLayout>
